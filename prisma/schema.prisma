model PosSession {
  id          String    @id @default(uuid())
  staffId     String
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  totalSales  Float     @default(0) // 💰 total ₦ for the session
  orderCount  Int       @default(0) // 🧾 number of orders
  cashAmount  Float     @default(0) // 💵 total paid in cash
  transferAmt Float     @default(0) // 💸 total paid via transfer
  posRevenue  Float     @default(0) // 🧾 subtotal w/o tax
  taxAmount   Float     @default(0) // 🧾 session tax collected

  staff    User      @relation("StaffSessions", fields: [staffId], references: [id])
  posItems PosItem[]
  orders   Order[] // requires sessionId in Order
}

model PosItem {
  id        Int    @id @default(autoincrement())
  sessionId String
  productId Int
  quantity  Int
  unitPrice Float

  session PosSession @relation(fields: [sessionId], references: [id])
  product Product    @relation(fields: [productId], references: [id])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    String
  productId Int
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Setting {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  value       String
  description String?
}

model DeliverySetting {
  id                    Int            @id @default(autoincrement())
  enableDelivery        Boolean        @default(true)
  enablePickup          Boolean        @default(true)
  defaultDeliveryFee    Int            @default(350)
  minimumOrderAmount    Int            @default(1000)
  estimatedDeliveryTime Int            @default(45)
  deliveryRadius        Int            @default(10)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  zones                 DeliveryZone[]
}

model DeliveryZone {
  id        Int      @id @default(autoincrement())
  name      String
  fee       Int
  settingId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setting DeliverySetting @relation(fields: [settingId], references: [id])
}

model RestaurantInfo {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  address     String
  phone       String
  email       String
  website     String
  logo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
